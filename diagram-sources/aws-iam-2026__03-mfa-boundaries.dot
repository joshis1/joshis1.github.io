digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65"]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.25,0.18", color="#C5D3E2", fillcolor="#EDF4FA", fontcolor="#172B46"]; edge [arrowsize=.75, color="#526984", fontname="DejaVu Sans", fontsize=11]; b [label="Builder ID MFA\nWebAuthn registered", fillcolor="#DEF5E9"]; console [label="Protects AWS Builder ID sign-in", fillcolor="#DEF5E9"]; i [label="IAM lab user\nNo MFA device configured", fillcolor="#FFF2DB"]; key [label="Programmatic access key\nNot automatically MFA-bound", fillcolor="#FFF2DB"]; note [label="Two different identities\nTwo different security configurations", shape=note, fillcolor="#EDF0FC", color="#9DACE2"]; b -> console; i -> key; {rank=same;b;i}; {rank=same;console;key}; console -> note [style=dashed, arrowhead=none]; key -> note [style=dashed, arrowhead=none]; }
